{
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "200000"
  },
  "permissions": {
    "allow": [
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(grep:*)",
      "Bash(tr:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git tag:*)",
      "Bash(git check-ignore:*)",
      "Bash(git -C:*)",
      "Bash(git worktree *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git branch *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "outputStyle": "Critical Engineer"
}
